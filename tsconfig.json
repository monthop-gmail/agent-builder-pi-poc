{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["builder/**/*.ts", "runtime/**/*.ts", "tools/**/*.ts", "skills/**/*.ts", "mcp/**/*.ts", "cli/**/*.ts"],
  "exclude": ["node_modules", "tests", "dist"]
}
